<Page x:Class="Pr15.Pages.ConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConfirmPage">
    <StackPanel Margin="40" MaxWidth="400">
        <TextBlock Text="Сохранить сборку?" FontSize="20" Margin="0,0,0,16"/>
        <TextBlock Text="Название:" Margin="0,0,0,4"/>
        <TextBox x:Name="tbName" Text="Моя сборка"/>
        <TextBlock Text="Автор:" Margin="0,12,0,4"/>
        <TextBox x:Name="tbAuthor" Text="Пользователь"/>
        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="100" Margin="0,0,12,0" Click="Cancel_Click"/>
            <Button Content="Сохранить" Width="100" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
