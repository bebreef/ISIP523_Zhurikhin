<Page x:Class="Pr15.Pages.CurrentBuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Pr15.Pages"
      xmlns:app="clr-namespace:Pr15"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CurrentBuildPage">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Выбранные комплектующие" FontSize="16" Margin="0,0,0,8"/>
            <ListBox x:Name="lbBuild" ItemsSource="{Binding Source={x:Static app:App.CurrentBuild}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding name}" Width="240"/>
                            <TextBlock Text="{Binding price, StringFormat='{}{0:N0} ₽'}" Margin="12,0"/>
                            <Button Content="×" Width="30" Click="Remove_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Итого" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="tbTotal" FontSize="22" Margin="0,8"/>
            <TextBlock Text="Совместимость:" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <TextBlock x:Name="tbCompat" TextWrapping="Wrap"/>
            <Button Content="Сохранить" Margin="0,24,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Page>
