<Page x:Class="Pr15.Pages.SavedBuildsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pr15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SavedBuildsPage">
    <StackPanel Margin="20">
        <TextBlock Text="Сохранённые сборки" FontSize="20" Margin="0,0,0,16"/>
        <ListBox x:Name="lbSaved" MouseDoubleClick="lbSaved_MouseDoubleClick"/>
    </StackPanel>
</Page>
