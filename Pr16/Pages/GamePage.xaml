<Page x:Class="Pr16.Pages.GamePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#111111">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HUD: HP и Stamina -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,16">
            <TextBlock Text="HP:" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
            <ProgressBar Width="240" Height="20" Margin="12,0" Value="{Binding Player.HP}" Maximum="{Binding Player.MaxHP}" Foreground="#00FF41"/>
            <TextBlock Text="{Binding Player.HP, StringFormat=' {0}/{1}'}" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
            <TextBlock Text="Stamina:" Foreground="White" FontSize="18" Margin="32,0,0,0" VerticalAlignment="Center"/>
            <ProgressBar Width="180" Height="20" Margin="12,0" Value="{Binding Player.Stamina}" Maximum="{Binding Player.MaxStamina}" Foreground="#4096EE"/>
            <TextBlock Text="{Binding Player.Stamina, StringFormat=' {0}/{1}'}" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Левый столбец — Журнал событий -->
            <Border Grid.Column="0" Background="#1A1A2E" CornerRadius="12" Margin="0,0,8,0" Padding="12" BorderBrush="#333344" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Журнал событий" Foreground="White" FontSize="20" Margin="0,0,0,12"/>
                    <ListBox x:Name="LogListBox" ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Foreground="#D0D0D0" FontSize="14" ScrollViewer.VerticalScrollBarVisibility="Auto" Loaded="LogListBox_Loaded">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Правый столбец -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Визуал -->
                    <RowDefinition Height="Auto"/>
                    <!-- Инвентарь -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопки -->
                </Grid.RowDefinitions>

                <!-- Визуальная часть -->
                <Grid Grid.Row="0">
                    <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill" Opacity="0.4"/>
                    <Image Source="{Binding EncounterImagePath}" Stretch="Uniform" VerticalAlignment="Center" Margin="20" MaxHeight="420"/>
                </Grid>

                <!-- Инвентарь (оружие, броня, еда, зелья) -->
                <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="12" Margin="0,8,0,8" Padding="12" BorderBrush="#333344" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Инвентарь" Foreground="White" FontSize="18" Margin="0,0,0,8"/>

                        <!-- Текущее оружие -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Width="48" Height="48" Source="{Binding Player.equippedweapon, Converter={StaticResource WeaponImageConverter}}" Stretch="Uniform"/>
                            <TextBlock Text="{Binding Player.equippedweapon.name}" Foreground="#FFD700" FontSize="16" VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>

                        <!-- Текущая броня -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Width="48" Height="48" Source="{Binding Player.equippedarmor, Converter={StaticResource ArmorImageConverter}}" Stretch="Uniform"/>
                            <TextBlock Text="{Binding Player.equippedarmor.name}" Foreground="#A0D8FF" FontSize="16" VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>

                        <!-- Предметы из инвентаря (еда и зелья) -->
                        <ItemsControl ItemsSource="{Binding Player.Inventory}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="4" Padding="4" Click="InventoryItem_Click" Tag="{Binding}">
                                        <Image Width="48" Height="48" Source="{Binding ., Converter={StaticResource InventoryImageConverter}}" Stretch="Uniform"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Кнопки действий -->
                <Border Grid.Row="2" Background="#1A1A2E" CornerRadius="12" Padding="12" BorderBrush="#333344" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Действия" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding FightingControlsVisibility}">
                            <Button Content="Атаковать" Width="140" Height="52" Margin="8" FontSize="16" Click="Attack_Click"/>
                            <Button Content="Защищаться" Width="140" Height="52" Margin="8" FontSize="16" Click="Defend_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding ChestControlsVisibility}" Margin="0,12,0,0">
                            <Button Content="Взять" Width="140" Height="52" Margin="8" FontSize="16" Background="#2E7D32" Click="UseItem_Click"/>
                            <Button Content="Оставить" Width="140" Height="52" Margin="8" FontSize="16" Background="#616161" Click="SkipItem_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>