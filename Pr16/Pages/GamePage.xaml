<Page x:Class="Pr16.Pages.GamePage"    
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Background="#111111">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,16">

            <TextBlock Text="HP:" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding HpText}" Foreground="#00FF41" FontSize="18" Margin="8,0"/>

            <TextBlock Text="Stamina:" Foreground="White" FontSize="18" Margin="32,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StaminaText}" Foreground="#4096EE" FontSize="18" Margin="8,0"/>

            <TextBlock Text="Этаж:" Foreground="White" FontSize="18" Margin="32,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Floor}" Foreground="#4096EE" FontSize="18" Margin="8,0"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#1A1A2E" CornerRadius="12" Margin="0,0,8,0" Padding="12" BorderBrush="#333344" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Журнал событий" Foreground="White" FontSize="20" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" Padding="4" Focusable="True" PanningMode="VerticalOnly">
                        <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="#D0D0D0" FontSize="14" FontFamily="Consolas" Padding="0" Margin="0" AcceptsTab="False"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Image Source="{Binding BackgroundImagePath}" Stretch="UniformToFill" Opacity="0.4"/>
                    <Image Source="{Binding EncounterImagePath}" Stretch="Uniform" VerticalAlignment="Center" Margin="20" MaxHeight="420"/>
                </Grid>

                <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="12" Margin="0,8,0,8" Padding="12" BorderBrush="#333344" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Инвентарь" Foreground="White" FontSize="18" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Оружие:" Foreground="White" FontSize="14"/>
                                <TextBlock Text="{Binding Player.equippedweapon.name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Player.equippedweapon.dmg, StringFormat='Урон: {0}'}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Броня:" Foreground="White" FontSize="14"/>
                                <TextBlock Text="{Binding Player.equippedarmor.name}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Player.equippedarmor.defense, StringFormat='Защита: {0}'}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Player.Inventory}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="InventoryItem_Click" Tag="{Binding}" Margin="4" Padding="4" MinWidth="80">
                                        <StackPanel>
                                            <Image Source="{Binding ImagePath}" Width="40" Height="40"/>
                                            <TextBlock Text="{Binding name}" Foreground="White" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding StatText}" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#1A1A2E" CornerRadius="12" Padding="12" BorderBrush="#333344" BorderThickness="1">
                    <StackPanel>

                        <TextBlock Text="Действия" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding FightingControlsVisibility}">
                            <Button Content="Атаковать" Width="140" Height="52" Margin="8" FontSize="16" Click="Attack_Click"/>
                            <Button Content="Защищаться" Width="140" Height="52" Margin="8" FontSize="16" Click="Defend_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding ChestControlsVisibility}" Margin="0,12,0,0">
                            <Button Content="{Binding ChestAction1Text}" Width="140" Height="52" Margin="8" FontSize="16" Background="#2E7D32" Click="UseItem_Click"/>
                            <Button Content="{Binding ChestAction2Text}" Width="140" Height="52" Margin="8" FontSize="16" Background="#616161" Click="SecondChestAction_Click"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Page>