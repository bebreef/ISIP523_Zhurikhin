<Window x:Class="UPShootAndBunny.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Читай, Пиши и не спиши" Height="720" Width="1150" Icon="Covers/icon.ico" WindowStartupLocation="CenterScreen" Background="#F5F5F7">
    <Window.Resources>
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0 4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1C1C1E" x:Name="SidebarBorder" Visibility="Collapsed">
            <StackPanel Margin="0 24 0 0">
                <Button x:Name="BtnCatalog" Style="{StaticResource SidebarBtn}" Content="📖" ToolTip="Каталог" Click="Go_Catalog"/>
                <Button x:Name="BtnLists" Style="{StaticResource SidebarBtn}" Content="📑" ToolTip="Списки" Click="Go_Lists"/>
                <Button x:Name="BtnProfile" Style="{StaticResource SidebarBtn}" Content="👤" ToolTip="Профиль" Click="Go_Profile"/>
                <Button x:Name="BtnAuthor" Style="{StaticResource SidebarBtn}" Content="✒️" ToolTip="Автор" Click="Go_Author" Visibility="Collapsed"/>
                <Button x:Name="BtnAdmin" Style="{StaticResource SidebarBtn}" Content="⚙️" ToolTip="Админ" Click="Go_Admin" Visibility="Collapsed"/>
                <Button Style="{StaticResource SidebarBtn}" Content="🚪" ToolTip="Выход" Click="Btn_Logout" Margin="0 24 0 0"/>
            </StackPanel>
        </Border>
        <Frame Grid.Column="1" NavigationUIVisibility="Hidden" x:Name="MainFrame"/>
    </Grid>
</Window>