<Page x:Class="UPShootAndBunny.Pages.AddBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F7">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Center">
            <TextBlock Text="Информация о книге" FontSize="24" FontWeight="Bold" Foreground="#1C1C1E" Margin="0 0 0 20"/>
            <TextBlock Text="Название" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" Margin="0 0 0 4"/>
            <TextBox x:Name="TbTitle" Height="42" Padding="10 0" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Center" Margin="0 0 0 16"/>

            <TextBlock Text="Описание" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" Margin="0 0 0 4"/>
            <TextBox x:Name="TbDesc" Height="80" Padding="10 0" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Top" TextWrapping="Wrap" Margin="0 0 0 16"/>

            <TextBlock Text="Путь к обложке" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" Margin="0 0 0 4"/>
            <Grid Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TbCover" Height="42" Padding="10 0" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Center"/>
                <Button Content="..." Grid.Column="1" Width="42" Height="42" Margin="8 0 0 0" Background="#E5E5EA" Foreground="#1C1C1E" BorderThickness="0" Click="Btn_SelectCover"/>
            </Grid>

            <TextBlock Text="Текст книги" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" Margin="0 0 0 4"/>
            <TextBox x:Name="TbContent" Height="300" Padding="10 0" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" Margin="0 0 0 16"/>

            <Button x:Name="BtnSave" Content="Сохранить" Height="48" Background="#007AFF" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="Btn_Save" Cursor="Hand"/>
            <Button Content="Назад" Height="36" Margin="0 12 0 0" Background="Transparent" Foreground="#8E8E93" BorderThickness="0" Click="Btn_Back"/>
        </StackPanel>
    </ScrollViewer>
</Page>