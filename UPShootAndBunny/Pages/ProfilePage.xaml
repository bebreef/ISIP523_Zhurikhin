<Page x:Class="UPShootAndBunny.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F7">
    <Page.Resources>
        <DropShadowEffect x:Key="DropShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#FFFFFF" Padding="20" CornerRadius="16" Margin="0 0 0 20" Effect="{StaticResource DropShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TbName" FontSize="28" FontWeight="Bold" Foreground="#1C1C1E"/>
                    <TextBlock x:Name="TbLogin" FontSize="16" Foreground="#8E8E93" Margin="0 4 0 0"/>
                    <TextBlock x:Name="TbEmail" FontSize="14" Foreground="#8E8E93" Margin="0 2 0 0"/>
                    <TextBlock x:Name="TbRole" FontSize="14" Foreground="#007AFF" FontWeight="SemiBold" Margin="0 8 0 0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnRequestAuthor" Content="Стать автором" Height="40" Padding="20 0" Background="#34C759" Foreground="White" BorderThickness="0" Click="Btn_RequestAuthor" Cursor="Hand"/>
                    <Button x:Name="BtnDispute" Content="Оспорить заморозку" Height="40" Padding="16 0" Margin="10 0 0 0" Background="#FF9500" Foreground="White" BorderThickness="0" Click="Btn_Dispute" Visibility="Collapsed" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="FreezeWarning" Background="#FF3B30" Padding="16" CornerRadius="12" Margin="0 0 0 20" Visibility="Collapsed">
            <TextBlock x:Name="TbFreezeReason" TextWrapping="Wrap" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Мои отзывы" FontSize="20" FontWeight="Bold" Foreground="#1C1C1E" Margin="0 0 0 12"/>
                <ItemsControl x:Name="ReviewsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" Padding="16" CornerRadius="12" Margin="0 0 0 12" Effect="{StaticResource DropShadow}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Books.Title}" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                                    <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" Margin="0 6 0 0" Foreground="#1C1C1E"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>