<Page x:Class="UPShootAndBunny.Pages.CatalogPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F5F7">
    <Page.Resources>
        <DropShadowEffect x:Key="DropShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#FFFFFF" Padding="16" CornerRadius="12" Margin="0 0 0 20" Effect="{StaticResource DropShadow}">
            <WrapPanel Orientation="Horizontal">
                <TextBox x:Name="TbTitle" Width="200" Padding="8" Margin="0 0 10 0" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Center" TextChanged="TbTitle_TextChanged" ToolTip="Поиск по названию"/>
                <TextBox x:Name="TbAuthor" Width="200" Padding="8" Margin="0 0 10 0" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Center" TextChanged="TbAuthor_TextChanged" ToolTip="Поиск по автору"/>
                <ComboBox x:Name="CbGenre" Width="160" Margin="0 0 10 0" Padding="8" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" SelectionChanged="CbGenre_SelectionChanged" DisplayMemberPath="GenreName" SelectedValuePath="GenreId" ToolTip="Жанр"/>
                <ComboBox x:Name="CbSort" Width="160" Margin="0 0 10 0" Padding="8" FontSize="14" BorderBrush="#D1D1D6" BorderThickness="1" SelectionChanged="CbSort_SelectionChanged" ToolTip="Сортировка">
                    <ComboBoxItem Content="По имени (А-Я)" IsSelected="True"/>
                    <ComboBoxItem Content="По рейтингу"/>
                </ComboBox>
                <Button Content="Сбросить" Height="36" Padding="14 0" Background="#E5E5EA" Foreground="#1C1C1E" BorderThickness="0" Click="Btn_ResetFilters" Cursor="Hand"/>
            </WrapPanel>
        </Border>
        <ListView Grid.Row="1" x:Name="BooksList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF" Width="220" Height="300" CornerRadius="12" Margin="10" Effect="{StaticResource DropShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill" Margin="0 0 0 10"/>
                            <StackPanel Grid.Row="1" Margin="12 0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="#1C1C1E"/>
                                <TextBlock Text="{Binding Users.DisplayName}" FontSize="12" Foreground="#8E8E93" Margin="0 4 0 0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12 8">
                                <Button Content="Читать" Width="60" Height="28" Background="#007AFF" Foreground="White" BorderThickness="0" Click="Btn_Read" Margin="0 0 6 0" FontSize="11"/>
                                <Button Content="+" Width="28" Height="28" Background="#E5E5EA" Foreground="#007AFF" BorderThickness="0" Click="Btn_AddToList" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
