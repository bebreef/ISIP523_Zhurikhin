<Page x:Class="UPShootAndBunny.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Мои публикации" FontSize="28" FontWeight="Bold" Foreground="#1C1C1E" VerticalAlignment="Center"/>
            <Button Content="Добавить книгу" HorizontalAlignment="Right" Height="40" Padding="20 0" Background="#34C759" Foreground="White" BorderThickness="0" Click="Btn_AddBook" Cursor="Hand"/>
        </Grid>
        <ListView x:Name="BooksList" Grid.Row="1" Margin="0 16 0 0" BorderThickness="0" Background="Transparent">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF" Width="220" Height="300" Margin="10" Effect="{StaticResource DropShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="160"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill" Margin="0 0 0 8"/>
                            <StackPanel Grid.Row="1" Margin="12 0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" MaxHeight="40" Foreground="#1C1C1E"/>
                                <TextBlock x:Name="TbStatus" FontSize="11" Foreground="#34C759" Margin="0 4 0 0" Text="✓ Опубликовано"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12 8">
                                <Button Content="Изменить" Width="65" Height="26" Background="#E5E5EA" Foreground="#007AFF" BorderThickness="0" Click="Btn_Edit" Margin="0 0 4 0" Tag="{Binding}"/>
                                <Button x:Name="BtnDispute" Content="Жалоба" Width="70" Height="26" Background="#E5E5EA" Foreground="#FF3B30" BorderThickness="0" Click="Btn_Dispute" Tag="{Binding}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                            <Setter TargetName="TbStatus" Property="Text" Value="⚠ Заморожено"/>
                            <Setter TargetName="TbStatus" Property="Foreground" Value="#FF3B30"/>
                            <Setter TargetName="BtnDispute" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>