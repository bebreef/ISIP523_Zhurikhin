<Page x:Class="UPShootAndBunny.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F7">
    <ScrollViewer>
        <StackPanel Margin="24">
            <Grid Margin="0 0 0 24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding CoverPath}" Width="280" Height="420" Stretch="UniformToFill"/>
                <StackPanel Grid.Column="1" Margin="24 0 0 0">
                    <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" Foreground="#1C1C1E"/>
                    <TextBlock x:Name="TbAuthor" FontSize="16" Foreground="#8E8E93" Margin="0 4 0 16"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="14" Foreground="#1C1C1E" Margin="0 0 0 16"/>
                    <TextBlock x:Name="TbGenres" FontSize="13" Foreground="#007AFF" Margin="0 0 0 16"/>
                    <TextBlock x:Name="TbRating" FontSize="14" FontWeight="SemiBold" Foreground="#1C1C1E" Margin="0 0 0 16"/>
                    <WrapPanel>
                        <Button Content="Читать" Height="40" Padding="20 0" Background="#007AFF" Foreground="White" BorderThickness="0" Click="Btn_Read"/>
                        <Button Content="Жалоба на книгу" Height="40" Padding="16 0" Margin="8 0 0 0" Background="#FF3B30" Foreground="White" BorderThickness="0" Click="Btn_ComplaintBook"/>
                        <Button Content="Жалоба на автора" Height="40" Padding="16 0" Margin="8 0 0 0" Background="#FF9500" Foreground="White" BorderThickness="0" Click="Btn_ComplaintAuthor"/>
                        <Button x:Name="BtnFreeze" Content="Заморозить книгу" Height="40" Padding="16 0" Margin="8 0 0 0" Background="#8E8E93" Foreground="White" BorderThickness="0" Visibility="Collapsed" Click="Btn_FreezeBook"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <TextBlock Text="Отзывы" FontSize="24" FontWeight="Bold" Foreground="#1C1C1E" Margin="0 0 0 16"/>
            <ItemsControl x:Name="ReviewsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF" Padding="16" CornerRadius="12" Margin="0 0 0 12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Users.DisplayName}" FontWeight="SemiBold" Foreground="#1C1C1E"/>
                                    <TextBlock Text="{Binding Rating, StringFormat=' ★ {0}/10'}" Foreground="#FF9500" Margin="8 0 0 0"/>
                                    <Button x:Name="BtnComplaintReview" Content="Жалоба" FontSize="11" Margin="8 0 0 0" Foreground="#FF3B30" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="Btn_ComplaintReview" Tag="{Binding ReviewId}"/>
                                    <Button x:Name="BtnFreezeReview" Content="Заморозить" FontSize="11" Margin="8 0 0 0" Foreground="#FF9500" Background="Transparent" BorderThickness="0" Click="Btn_FreezeReview" Tag="{Binding ReviewId}" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding ReviewText}" TextWrapping="Wrap" Foreground="#1C1C1E" Margin="0 8 0 0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="TbReview" Height="80" Padding="12" Margin="0 16 0 8" TextWrapping="Wrap" BorderBrush="#D1D1D6" BorderThickness="1" VerticalContentAlignment="Top"/>
            <ComboBox x:Name="CbRating" Width="60" Margin="0 0 0 8">
                <ComboBoxItem Content="10" IsSelected="True"/>
                <ComboBoxItem Content="9"/>
                <ComboBoxItem Content="8"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="6"/>
                <ComboBoxItem Content="5"/>
            </ComboBox>
            <Button Content="Оставить отзыв" Height="40" Background="#34C759" Foreground="White" BorderThickness="0" Click="Btn_AddReview" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Page>